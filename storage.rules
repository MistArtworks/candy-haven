rules_version = '2';

// Cloud Storage for Firebase: CONSULTATION's shared tracks. Pasted into the
// Firebase console, Storage -> Rules. See docs/CONSULTATION.md.
//
// Only the two DISPATCH accounts may put a track up, read it back or delete
// it, and only audio, only under consultation/, 200 MB at most. The website's
// page plays a track through its download address, whose token is what lets
// it in, so these rules never see a producer. Everything else is shut.
//
// The UIDs must match database.rules.json and ACCOUNT_UID in
// src/main/services/dispatch/identity.auth.ts.
service firebase.storage {
  match /b/{bucket}/o {
    function isHaven() {
      return request.auth != null
        && request.auth.uid in ['Uc1ZbVbKXmU8cU5iSK3kWtNKXJD2', 'u9mDaxAH3MZbgyIPith4lBF4Mn63'];
    }

    match /consultation/{file} {
      allow get, delete: if isHaven();
      // A new track only: each is uploaded under a name of its own, so
      // nothing already shared is ever overwritten.
      allow create: if isHaven()
        && request.resource.size <= 200 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
    }
  }
}
